# Copy to .env, fill in, then `chmod 600 .env`. Nothing ever prints a value.
HEALTH_INFO_IMAGE=health-info:local
HEALTH_INFO_SECRET_KEY=
HEALTH_INFO_ALLOWED_HOSTS=health.example.com
HEALTH_INFO_CSRF_TRUSTED_ORIGINS=https://health.example.com
HEALTH_INFO_TIME_ZONE=Europe/Stockholm
HEALTH_INFO_MIGRATE_ON_START=true
HEALTH_INFO_TRUST_PROXY=true
HEALTH_INFO_NETWORK=health-info
PROXY_NETWORK=proxy
APP_UID=10001
APP_GID=10001
APP_DATA_PATH=/volume1/docker/health-info/data
APP_BACKUP_PATH=/volume1/docker/health-info/backups
APP_RESTORE_PATH=/volume1/docker/health-info/restores
